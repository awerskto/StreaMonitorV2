# Copy to .env and adjust. Every value is optional; the defaults are shown.

# --- Web server -----------------------------------------------------------
# Bind address and port of the web interface.
#STRMNTR_HOST=0.0.0.0
#STRMNTR_PORT=5090
# Password for the web interface. Empty disables authentication.
#STRMNTR_PASSWORD=admin
# Web UI skin: only the single page application "tube" ships
#STRMNTR_SKIN=tube
# How often the streamer list refreshes, in seconds.
#STRMNTR_LIST_FREQ=30
# How often the status of one streamer refreshes, in seconds.
#STRMNTR_STATUS_FREQ=5
# Confirm before deleting: "" disables, MOBILE only on mobile, anything else always.
#STRMNTR_CONFIRM_DEL=MOBILE

# --- Recording ------------------------------------------------------------
# Where recordings are stored.
#STRMNTR_DOWNLOAD_DIR=downloads
# Resolution to download: 240, 360, 480, 720, 1080, 1440.
#STRMNTR_RESOLUTION=480
# How the resolution is matched: exact, closest, exact_or_least_higher, exact_or_highest_lower.
#STRMNTR_RESOLUTION_PREF=closest
# Output container: mp4 or mkv.
#STRMNTR_CONTAINER=mp4
# Split recordings into segments of this length, e.g. 1:00:00. Empty keeps one file.
#STRMNTR_SEGMENT_TIME=
# Speed at which ffmpeg reads the stream. 0 is safest for low latency streams.
#STRMNTR_FFMPEG_READRATE=1.3
# Full path to ffmpeg. Defaults to the build in ../ffmpeg/bin.
#STRMNTR_FFMPEG_PATH=
# Full path to ffprobe. Defaults to the build in ../ffmpeg/bin.
#STRMNTR_FFPROBE_PATH=
# How often the local master playlist is refreshed while recording, in seconds.
#STRMNTR_PLAYLIST_REFRESH=120

# --- Media pipeline -------------------------------------------------------
# Generate posters and animated previews after a recording finishes.
#STRMNTR_THUMBS=on
#STRMNTR_SCRUB=on
# Number of parallel workers. Keep at 1 on small hosts.
#STRMNTR_THUMB_WORKERS=1
# Hardware acceleration: auto, off, nvenc, vaapi, qsv, amf, videotoolbox.
#STRMNTR_HWACCEL=auto
# VAAPI render device.
#STRMNTR_VAAPI_DEVICE=/dev/dri/renderD128
# Also write a 360p proxy of every recording. Off by default: it doubles disk usage.
#STRMNTR_PROXY=off
#STRMNTR_PROXY_HEIGHT=360
# Where posters, previews and the metadata database are stored.
#STRMNTR_CACHE_DIR=downloads/.cache
# How often the cache sweep removes files that disappeared, in minutes.
#STRMNTR_CACHE_SWEEP_MIN=15
# External command run after a recording finishes. The file path is passed as argument.
#STRMNTR_POST_RECORD_CMD=
